{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "l2split",
  "version": "0.1.1",
  "identifier": "dev.l2split.app",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "l2split",
        "decorations": false,
        "center": true,
        "width": 1080,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#121316"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "driver/ndis.msi"
    ]
  }
}
